{
	"$schema": "https://biomejs.dev/schemas/2.5.14/schema.json",
	"vcs": { "enabled": true, "clientKind": "git", "useIgnoreFile": true },
	"files": { "includes": ["**", "!node_modules", "!dist"] },
	"overrides": [
		{
			"includes": ["test/**"],
			"linter": {
				"rules": {
					"style": { "noNonNullAssertion": "off" },
					"correctness": { "noUnsafeOptionalChaining": "off" },
					"complexity": { "useLiteralKeys": "off" }
				}
			}
		}
	],
	"formatter": { "enabled": true, "indentStyle": "tab", "lineWidth": 100 },
	"linter": {
		"enabled": true,
		"rules": { "preset": "recommended", "style": { "noNonNullAssertion": "error" } }
	},
	"assist": { "actions": { "source": { "organizeImports": "on" } } }
}
